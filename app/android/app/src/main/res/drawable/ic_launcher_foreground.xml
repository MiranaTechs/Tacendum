<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's foreground: the app icon's two bars, in
     its 1024 space, mapped onto the 72dp visible area centred in the
     108dp layer (scale 72/1024, offset 18dp), so the mark keeps the iOS
     icon's proportions and stays inside the 66dp safe zone. The upper-left
     bar is OUTLINED (a 42-unit forest stroke, transparent fill) and the
     lower-right bar is SOLID forest: the two are told apart by value, never
     by hue. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.0703125"
        android:scaleY="0.0703125">
        <path
            android:strokeColor="#0E6B45"
            android:strokeWidth="42"
            android:fillColor="#00000000"
            android:pathData="M300.5,400 h228 a42.5,42.5 0 0 1 0,85 h-228 a42.5,42.5 0 0 1 0,-85 z"/>
        <path
            android:fillColor="#0E6B45"
            android:pathData="M496.5,535 h248 a63.5,63.5 0 0 1 0,127 h-248 a63.5,63.5 0 0 1 0,-127 z"/>
    </group>
</vector>
