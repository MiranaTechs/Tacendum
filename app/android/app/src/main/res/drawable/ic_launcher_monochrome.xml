<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's monochrome layer (themed icons): the foreground's
     group and paths in black; the launcher reads only the alpha and tints
     it. The upper-left path KEEPS its outline (stroke, transparent fill): a
     black fill there would turn the opening bar into a second solid bar and
     lose the mark's outlined-versus-solid meaning. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.0703125"
        android:scaleY="0.0703125">
        <path
            android:strokeColor="#000000"
            android:strokeWidth="42"
            android:fillColor="#00000000"
            android:pathData="M300.5,400 h228 a42.5,42.5 0 0 1 0,85 h-228 a42.5,42.5 0 0 1 0,-85 z"/>
        <path
            android:fillColor="#000000"
            android:pathData="M496.5,535 h248 a63.5,63.5 0 0 1 0,127 h-248 a63.5,63.5 0 0 1 0,-127 z"/>
    </group>
</vector>
