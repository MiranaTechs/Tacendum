<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      The night half of the launch window. Android does not merge the two
      files: in night mode this AppTheme replaces the day one outright, so it
      restates every item the day theme sets, with the night values. Keep the
      two item lists identical; only the colours may differ.

      These are theme.ts's dark `paperGround` (the window and both system
      bars, with light icons) and its dark `pine` (the accent). They follow
      the SYSTEM's dark setting, which is all a launch theme can see — the
      app's own stored choice reaches the screen one frame later: MainActivity
      repaints the navigation bar from it, and the first rendered frame reads
      it synchronously through AppearancePrefsModule's `initialAppearance`
      constant.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">#141414</item>
        <item name="colorAccent">#57AA7F</item>
        <item name="android:statusBarColor">#141414</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#141414</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

</resources>
