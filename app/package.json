  "private": true,
  "scripts": {
    "android": "react-native run-android --port 8083",
    "android:gradle": "./android/gradlew -p android",
    "android:check": "./android/gradlew -p android --no-daemon :app:generateCodegenArtifactsFromSchema :app:check",
    "android:assemble:debug": "./android/gradlew -p android --no-daemon :app:assembleDebug",
    "android:bundle:release": "./android/gradlew -p android --no-daemon :app:bundleRelease",
    "ios": "react-native run-ios --port 8083",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "start": "react-native start --port 8083",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "17.1.2",
    "@react-native/new-app-screen": "0.86.0",
    "@tacendum/shared": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "15.15.5",
    "react-native-webrtc": "124.0.8",
    "tacendum-attach": "workspace:*",
    "tacendum-audio": "workspace:*",
    "tacendum-call": "workspace:*",
    "tacendum-crypto": "workspace:*",
    "tacendum-qr": "workspace:*",
    "tacendum-screen-security": "workspace:*",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
