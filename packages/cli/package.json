{
  "name": "@tacendum/cli",
  "version": "0.1.0",
  "description": "End-to-end encrypted notifications to your phone from CLIs, cron jobs, CI, and AI coding agents - each integration is its own cryptographically distinct named sender (Signal protocol via libsignal).",
  "type": "module",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/MiranaTechs/Tacendum",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiranaTechs/Tacendum.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/MiranaTechs/Tacendum/issues"
  },
  "keywords": [
    "notifications",
    "push",
    "e2ee",
    "end-to-end-encryption",
    "signal-protocol",
    "libsignal",
    "claude-code",
    "codex",
    "hooks",
    "cli"
  ],
  "bin": {
    "tacendum": "./dist/main.js",
    "tacendum-cli": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node build.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/main.ts"
  },
  "dependencies": {
    "@signalapp/libsignal-client": "0.100.0",
    "ulid": "3.0.2",
    "uqr": "0.1.3",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tacendum/shared": "workspace:*",
    "@types/ws": "^8.18.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.228"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12"
  }
}
